	//if (false) {
		
		if ( jQuery('.tempalte-admin').length ) {
			try {
				jQuery(".date-input").datepicker({
					dateFormat: "dd-mm-yy",
					changeMonth: true,
					changeYear: true,
                    yearRange: "2012:c+20"
				});
				//jQuery("#bookingBirthDate").datepicker("option", "yearRange", "1920:+0");
			}
			catch(err) {}
		}
		
		if ( jQuery('#bookingPassengersForm #passengers').length ) {
			try {
				oTable = jQuery('#passengers').dataTable({ // jQuery('.datatable').dataTable({
					"bStateSave": true, 
					"bJQueryUI": false,
					// "iDisplayLength": -1, // display everything
					"aaSorting": [[ 1, "asc" ]], // Sort by second column asc
					"sPaginationType": "full_numbers",
					"oLanguage": {
						"sLengthMenu": "Display _MENU_ records per page",
						"sZeroRecords": "Nothing found - sorry",
						"sInfo": "Showing _START_ to _END_ of _TOTAL_ records",
						"sInfoEmpty": "Showing 0 to 0 of 0 records",
