		}
	//}

	jQuery('.sub-article h2').click(function() {
		
		var thisParent = $(this).parent();
		
		if (thisParent.hasClass('active')) {
			thisParent.find('.sub-article-content').slideUp(400, function(){
				thisParent.removeClass('active');
			});
		}
		else {
			$('.active .sub-article-content').slideUp(400);
			
			// $('.active').removeClass('active')
			$('.sub-article').removeClass('active');
			
			thisParent.addClass('active');
			
			thisParent.find('.sub-article-content').slideDown(400, function(){
				if ( $('.show-on-r').css('display') == 'block' ) {
					$('body,html').animate({
						scrollTop: thisParent.position().top
					}, 500);
				}
			});
			
		}
	});

	// - get hash from url
	var urlHashValue = window.location.hash;
	urlHashValue = urlHashValue.replace('#',"");
	// - if hash - open accordion item 
	if ( jQuery.isNumeric(urlHashValue) && jQuery('.sub-article').length ) {
		jQuery('.sub-article').each(function(index) {
			if ( index + 1 == urlHashValue ) {
