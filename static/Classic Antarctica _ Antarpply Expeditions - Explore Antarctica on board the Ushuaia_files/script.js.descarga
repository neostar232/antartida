			});
			
			$('.homepage.grid-978 .footer-wrapper').css({
				'height' : 528
			});
			
			$('.homepage #r-wrapper').css({
				'margin-bottom' : '-502px'
			});
			
			$('.homepage.grid-978 #r-wrapper').css({
				'margin-bottom' : '-528px'
			});
			
			$('.homepage #push').css({
				'height' : 502
			});
			
			$('.homepage.grid-978 #push').css({
