	$('#export-arr').click(function() {
		$('#fieldfilter').addClass('invis');
		$('button[name="exportword"]').addClass('invis');
	});
	
	$('#plus').click(function() {
		var number_of_selects = $('#fieldfilter div select').length;
		var new_child = $('#fieldfilter div select:nth-child(1)').clone();
		new_child.attr('name','data[custom_fields]['+number_of_selects+']');
		$('#fieldfilter div').append(new_child);
	});
	$('#minus').click(function() {
		var number_of_selects = $('#fieldfilter div select').length;
		if (number_of_selects > 1) {
			$('#fieldfilter div select:last-child').remove();
		}
	});
	
    
    // - map are click
    jQuery('map area').click(function(e){
        if ( jQuery(this).data('images').length ) {
            e.preventDefault();
            loadOverlay(jQuery(this).data('header'), jQuery(this).data('images'), jQuery(this).data('text'));
        }
    });
    
    
});

jQuery(window).scroll(function () {
	if ($('.page').hasClass('homepage') ) {
		try {
			moveFooter();
		}
		catch(err) {}
	}
});

jQuery('html, body').bind('touchmove',function(e){
	// e.preventDefault();
	if ($('.page').hasClass('homepage') ) {
		try {
			moveFooter();
		}
		catch(err) {}
	}
});

jQuery(window).bind("load", function() {
	
	var docHeight = $(document).height();
	var footerHeight = $('.footer-wrapper').height();
	var viewportHeight = $(window).height();
	
	// --- Homepage 
	if ( $('.page').hasClass('homepage') ) {
	
		if ( $(window).width() <= 978 ) {
			jQuery('.footer-wrapper').css({width: 'auto'});
			jQuery('.homepage.grid-978 #homebox-inner').css({
				padding : '26px 0'
			});
		}
		else {
			jQuery('.footer-wrapper').css({width: '100%'});
			jQuery('.homepage.grid-978 #homebox-inner').css({
				padding : '26px 12px'
			});
		}
		
		if ( $(window).width() <= 760 ) {
			jQuery('.footer-wrapper').css({
				width: '100%',
				position: 'static'
			});
			jQuery('.footer-sticky').css({position: 'static'});
		}
		
	}
	// ---
	
	if ( $(window).width() <= 760 ) {
		// - set sticky
		$('#r-wrapper').css({
			'margin-bottom' : '-' + footerHeight + 'px'
		});
		$('#push').css({
			'height' : footerHeight
		});
	}
	
	
});