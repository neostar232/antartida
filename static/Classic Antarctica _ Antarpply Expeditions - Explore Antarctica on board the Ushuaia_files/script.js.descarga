	}
	
//===================================
	$('#export-all').click(function() {
		$('#fieldfilter').addClass('invis');
		$('button[name="exportword"]').removeClass('invis');
	});
	$('#export-custom').click(function() {
		$('#fieldfilter').removeClass('invis');
