		}
		else {
		
			$.supersized({
				random			: 1,
				slide_interval	: 10000,
				transition		: 1,
				transition_speed: 1000,
				fit_always		: 0,
				fit_landscape	: 0,
				fit_portrait	: 1,
				vertical_center	: 1,
				slide_links		: false,
				slides			:  	[
								{ image : "/img/bground/background2.jpg", title : "", alttext : "" },
								{ image : "/img/bground/background4.jpg", title : "", alttext : "" },
								{ image : "/img/bground/background5.jpg", title : "", alttext : "" },
								{ image : "/img/bground/background6.jpg", title : "", alttext : "" },
								{ image : "/img/bground/background7.jpg", title : "", alttext : "" },
