		try {
		
			var preLoadTimer;
			
			$(this).mousemove(function(e){
				$('.header-wrapper-box').fadeIn();
				$('.footer-wrapper').fadeIn();
				window.clearTimeout(preLoadTimer);
				preLoadTimer = window.setTimeout(hideControls, 4000);
			});
			
			jQuery('html, body').bind('touchstart',function(e){
				$('.header-wrapper-box').fadeIn();
				$('.footer-wrapper').fadeIn();
				window.clearTimeout(preLoadTimer);
				preLoadTimer = window.setTimeout(hideControls, 4000);
			});
			
			preLoadTimer = window.setTimeout(hideControls, 4000);
		
		}
		catch(err) {}
		
	}
	//---------------------------------------------
	
	
	if ($('.page').hasClass('page-availability')) {
		$('select').change(function(){
