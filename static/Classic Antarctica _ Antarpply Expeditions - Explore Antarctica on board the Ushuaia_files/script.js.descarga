			// - normal
			
			$('.footer-wrapper').css({
				'height' : 'auto'
			});
			
			$('#r-wrapper').css({
				'margin-bottom' : 0
			});
			
			$('#push').css({
				'height' : 0
			});
			
			// - home
			
			$('.homepage .footer-wrapper').css({
