function loadOverlay(header, image, text) {
	var parts = image.split("|");
	if (parts.length > 0) {
		$('.load-item-prev').hide();
		$('.load-item-next').hide();
		var image_content = "";
		for (i=0; i<parts.length; i++) {
			image_content += '<img src="'+parts[i]+'" alt="Deck details" title="Deck details" />';
		}
		$('.ovl-content').html('<h2>'+header+'</h2><div class="ovl-images">'+image_content+'</div>'+text);
		$('#overlay-container').show();
		if (parts.length > 1) {
			$('.load-item-prev').show();
			$('.load-item-next').show();
		}
	}
}

function codeToString(code) {
	
	var months = {"01" : "January", "02": "February", "03" : "March", "04" : "April", "05" : "May", "06" : "June", "07" : "July", "08" : "August", "09" : "September", "10" : "October", "11" : "November", "12" : "December"};
	
	if ( $('body').hasClass('body-lang-es') ) {
		months = {"01" : "Enero", "02": "Febrero", "03" : "Marzo", "04" : "Abril", "05" : "Mayo", "06" : "Junio", "07" : "Julio", "08" : "Agosto", "09" : "Septiembre", "10" : "Octubre", "11" : "Noviembre", "12" : "Diciembre"};
	}
	
	if (code.length > 7) 
		return months[code.substring(3,5)] + " " + code.substring(1,3) + ", 20" + code.substring(5,7);
	else return '';
}

function codeToDate(code, orientation) {
	if (code.length >= 7) {
		if ( orientation === 2 ) { // day-month-year
			return code.substring(1,3) + '-' + code.substring(3,5) + '-' + '20' + code.substring(5,7);
		}
		else { // year-month-day
			return '20' + code.substring(5,7) + '-' + code.substring(3,5) + '-' + code.substring(1,3);
		}
	}	
	else {
		return "";
	}
}

jQuery(document).ready(function(){
	var docHeight = $(document).height();
	var viewportHeight = $(window).height();
	var footerHeight = $('.footer-wrapper').height();
	var zzz = docHeight-viewportHeight-footerHeight;
	var contentWidth = 1218;
	var paddings = 15;
	
	if ($(window).width() < 1248) {
		$('.page').addClass('grid-978');
	}
	else {
		$('.page').removeClass('grid-978');
	}
	
	if ( $(window).width() <= 760 ) {
		$('.page').removeClass('grid-978');
	}
	
	if ( $.browser.msie && parseInt($.browser.version, 10) == 7 ) {
		$("body").addClass('ie7');
	}

	function updateHeader() {
		contentWidth = 1218;
		paddings = 0;
		if ( $('.page').hasClass('grid-978') ) {
			contentWidth = 978; paddings = 0;
		}
		
		if ( $(window).width() > contentWidth ) {
			var x1 = Math.floor(($(window).width() - contentWidth)/2);
			//var x2 = $(window).width() - contentWidth -x1;
			$('.long-left-bar').css({'padding-left': x1+paddings+"px", left: "-"+x1+"px"});
			$('.long-right-bar').css({'padding-right': x1+paddings+"px", right: "-"+x1+"px"});  //x2 here (removed because of IE7 and Chrome)
		}
		else {
			// remove paddings
			$('.long-left-bar').css({'padding-left': paddings+"px", left: 0});
			$('.long-right-bar').css({'padding-right': paddings+"px", right: 0});
		}
	}
	updateHeader();

	
	function moveFooter() {
		docHeight = $(document).height();
		footerHeight = $('.footer-wrapper').height();
		viewportHeight = $(window).height();
		zzz = docHeight - viewportHeight - footerHeight;
		
		if ( docHeight <= viewportHeight ) {
			if ( $(window).width() <= 760 ) {
				jQuery('.footer-wrapper').css({position: 'static'});
				jQuery('.footer-sticky').css({position: 'static'});
			}
		}
		else {
			if ( $(window).width() <= 760 ) {
				jQuery('.footer-wrapper').css({position: 'static'});
				jQuery('.footer-sticky').css({position: 'static'});
			}
			else {
				jQuery('.footer-wrapper').css({position: 'relative'});
			}
		}
	}
	
	
	if (!($('.page').hasClass('page-agents'))) {
		$('a:not([href=""])').each(function() {
			if (this.hostname !== location.hostname) {
				$(this).addClass('externalLink').attr('target', "_blank");
			}
		});
	}
	
	// --- on resize BEGIN
	jQuery(window).resize(function(){
		docHeight = $(document).height();
		viewportHeight = $(window).height();
		footerHeight = $('.footer-wrapper').height();
		zzz = docHeight-viewportHeight-footerHeight;
		
		if ( $(window).width() < 1248 ) {
			$('.page').addClass('grid-978');
		}
		else {
			$('.page').removeClass('grid-978');
		}
		
		if ( $(window).width() <= 760 ) {
			$('.page').removeClass('grid-978');
			
			if ($('.page').hasClass('homepage') ) {
				$('#supersized-loader').hide();
				$('#supersized').css({
					'opacity' : 0
				});
			}
			
			// - set sticky
			$('.footer-wrapper').css({
